# Copy to .env and fill in to run the action locally with @github/local-action:
#   npm run local-action
#
# Inputs are passed as INPUT_<NAME> (matching action.yml input names).
INPUT_CDKTNVERSION=0.23.3
INPUT_ENGINE=tofu
INPUT_ENGINEVERSION=
INPUT_MODE=synth-only
INPUT_WORKINGDIRECTORY=./
INPUT_STACKNAME=
INPUT_CLOUDTOKEN=
INPUT_GITHUBTOKEN=
INPUT_COMMENTONPR=false
INPUT_UPDATECOMMENT=true
INPUT_CUSTOMNPXARGS=
INPUT_CDKTNARGS=
INPUT_SUPPRESSOUTPUT=false
